  "scripts": [
    {
      "name": "world.lua",
      "lang": "lua",
      "code": "\n-- WorldAges: \u0432\u0435\u0441\u044C \u043C\u0438\u0440 \u0441 GitHub (Natural Earth). \u041A\u043B\u0438\u043A\u043D\u0438 \u0441\u0442\u0440\u0430\u043D\u0443 \u2014 \u0438\u0433\u0440\u0430\u0439 \u0437\u0430 \u043D\u0435\u0451.\n-- \u0421\u0432\u043E\u044F: \u043A\u043B\u0438\u043A \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C. \u0427\u0443\u0436\u0430\u044F \u0440\u044F\u0434\u043E\u043C \u2014 \u0430\u0442\u0430\u043A\u0430 (\u0441 \u043C\u043E\u0440\u044F \u043D\u0443\u0436\u0435\u043D \u043F\u043E\u0440\u0442). \u0414\u0430\u043B\u044C\u043D\u044F\u044F \u2014 \u0446\u0435\u043B\u044C \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0438.\n-- \u0425\u041E\u0414, \u041D\u0410\u0411\u041E\u0420 (50), \u0421\u0422\u0420\u041E\u0419 (\u0437\u0434\u0430\u043D\u0438\u044F/\u043F\u043E\u0440\u0442), \u041C\u0418\u0420/\u0421\u041E\u042E\u0417 \u043F\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u0438.\nlocal P={\n {n=\u0027Zimbabwe\u0027,x=11.4,y=12.8,o=\u0027Zimbabwe\u0027,a=30,col=\u0027#3E589E\u0027,k=0,f=0,r=0,port=false,nb={2,26,33,62,63,73,129,144,158},snb={20}},\n {n=\u0027Zambia\u0027,x=10.7,y=10.7,o=\u0027Zambia\u0027,a=50,col=\u0027#9E3A3A\u0027,k=0,f=0,r=0,port=false,nb={1,20,62,63,73,129,144,158},snb={33,42,86,130,140}},\n {n=\u0027Yemen\u0027,x=18.5,y=0.3,o=\u0027Yemen\u0027,a=50,col=\u0027#3E589E\u0027,k=0,f=0,r=0,port=false,nb={35,41,53,113,115,121},snb={11,29,34}},\n {n=\u0027Vietnam\u0027,x=42.3,y=-0.6,o=\u0027Vietnam\u0027,a=50,col=\u0027#3E589E\u0027,k=0,f=0,r=0,port=false,nb={19,72,82,132,138,139},snb={96,97}},\n {n=\u0027Venezuela\u0027,x=-27.1,y=3.7,o=\u0027Venezuela\u0027,a=50,col=\u0027#3E589E\u0027,k=0,f=0,r=0,port=false,nb={102,131,143},snb={27,48,51,90,119}},\n {n=\u0027Uzbekistan\u0027,x=24.7,y=-8.9,o=\u0027Uzbekistan\u0027,a=50,col=\u0027#3E589E\u0027,k=0,f=0,r=0,port=false,nb={14,21,83,87,132,161},snb={41,43,52,95,97}},\n {n=\u0027Uruguay\u0027,x=-22.5,y=17.7,o=\u0027Urugu