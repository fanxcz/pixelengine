  "scripts": [
    {
      "name": "hero.lua",
      "lang": "lua",
      "code": "-- hero.lua | Crystal Valley\n-- Movement is handled by the compatibility controller.\n-- A/D or arrows: move. W/Space: jump. F: shoot.\nlocal fireCooldown = 0\n\nfunction start()\n    api.log(\"Crystal Valley ready | A/D move | Space jump | F fire\")\nend\n\nfunction update(dt)\n    fireCooldown = math.max(0, fireCooldown - dt)\n    if api.key(\"f\") and fireCooldown <= 0 then\n        fireCooldown = 0.28\n        local direction = self.face\n        api.spawn(\"sprite\", {\n            name = \"MagicBolt\", sprite = \"bolt.png\",\n            x = self.x + direction * 6, y = self.y - 1,\n            w = 4.5, h = 4.5, color = \"#FFFFFF\",\n            gravity = false, solid = false, vx = direction * 235,\n            script = \"bolt.lua\"\n        })\n    end\nend\n"
    },
    {
      "name": "enemy.lua",
      "lang": "lua",
      "code": "-- enemy.lua | patrol and approach the player when nearby\nlocal homeX = 0\nfunction start()\n    homeX = self.x\n    self.num = 3\n    self.maxnum = 3\n    api.log(\"Crystal guardian spawned (3 HP)\")\nend\n\nfunction update(dt)\n    local hero = api.find(\"hero\")\n    if hero ~= nil then\n        local distance = hero.x - self.x\n        if math.abs(distance) < 46 then\n            self.vx = (distance >= 0 and 1 or -1) * 34\n        else\n            self.vx = math.sin(api.time() * 1.6) * 16\n        end\n    else\n        self.vx = math.sin(api.time() * 1.6) * 16\n    end\n    if self.x < homeX - 18 then self.vx = 22 end\n    if self.x > homeX + 18 then self.vx = -22 end\nend\n"
    },
    {
      "name": "bolt.lua",
      "lang": "lua",
      "code": "-- bolt.lua | projectile lifetime and simple target collision\nfunction start()\n    self:Set(\"age\", 0)\nend\n\nfunction update(dt)\n    self:Set(\"age\", self:Get(\"age\") + dt)\n    local target = api.find(\"enemy\")\n    if target ~= nil and math.abs(target.x - self.x) < 6 and math.abs(target.y - self.y) < 8 then\n        target.num = target.num - 1\n        target.hit()\n        if target.num <= 0 then target.destroy() end\n        self.destroy()\n        return\n    end\n    if self:Get(\"age\") > 1.15 or self.x < -110 or self.x > 110 then\n        self.destroy()\n    end\nend\n"
    }
  ],
