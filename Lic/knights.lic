        },
        {
          "name": "h1",
          "kind": "text",
          "x": 0,
          "y": -23.5,
          "w": 12,
          "h": 20,
          "color": "#DDDDDD",
          "text": "\u041E\u0413\u041E\u041D\u042C/\u041B\u0415\u0427: \u043C\u0430\u043D\u0430. \u0414\u041E\u0425\u041E\u0414/\u0421\u0422\u0415\u041D\u0410: \u043A\u0430\u0437\u043D\u0430 $.",
          "sprite": "",
          "solid": false,
          "gravity": false,
          "follow": false,
          "script": "",
          "pts": null
        },
        {
          "name": "h2",
          "kind": "text",
          "x": 0,
          "y": -17,
          "w": 12,
          "h": 20,
          "color": "#DDDDDD",
          "text": "U-\u0443\u0440\u043E\u043D I-\u0431\u0440\u043E\u043D\u044F. Space-\u043F\u0430\u0443\u0437\u0430 F-\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C.",
