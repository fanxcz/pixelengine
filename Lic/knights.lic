          "script": "",
          "pts": null
        },
        {
          "name": "h3",
          "kind": "text",
          "x": 0,
          "y": -10.5,
          "w": 12,
          "h": 20,
          "color": "#DDDDDD",
          "text": "G-\u0442\u043E\u0447\u043A\u0430, H-\u0434\u0435\u0440\u0436\u0430\u0442\u044C, R-\u043E\u0442\u0445\u043E\u0434, P-\u043F\u0430\u0443\u0437\u0430.",
